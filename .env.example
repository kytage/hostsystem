# Copie para .env e preencha com os dados do projeto Supabase novo.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<anon/publishable key>"
SUPABASE_PROJECT_ID="<ref>"
VITE_SUPABASE_URL="https://<ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon/publishable key>"
VITE_SUPABASE_PROJECT_ID="<ref>"

# Somente servidor — nunca exponha no navegador
SUPABASE_SERVICE_ROLE_KEY="<service_role key>"
SUPABASE_DB_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# Opcionais (integrações)
ONLINE_WEBHOOK_TOKEN=""
DISCORD_WEBHOOK_EVENTOS_URL=""
EVENTOS_SITE_URL=""
EVENTOS_SITE_TOKEN=""
LOVABLE_API_KEY=""
